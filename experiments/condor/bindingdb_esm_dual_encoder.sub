universe = docker
docker_image = $(image)
environment = "DATASAIL_CONTAINER_REF=$(image) DATASAIL_GIT_COMMIT=$(git_commit) DATASAIL_GIT_WORKTREE_DIRTY=$(git_dirty) CONDOR_JOB_ID=$(ClusterId).$(ProcId) OMP_NUM_THREADS=8 MKL_NUM_THREADS=8"
executable = experiments/condor/run_bindingdb_esm_dual_encoder.sh
arguments = $(repo_dir)
initialdir = $(repo_dir)
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
+WantGPUHomeMounted = true
requirements = (UidDomain == "cs.uni-saarland.de")
request_cpus = 8
request_memory = 16GB
request_disk = 12GB
log = $(repo_dir)/logs/condor/bindingdb.esm_dual_encoder.$(ClusterId).log
output = $(repo_dir)/logs/condor/bindingdb.esm_dual_encoder.$(ClusterId).$(ProcId).out
error = $(repo_dir)/logs/condor/bindingdb.esm_dual_encoder.$(ClusterId).$(ProcId).err
queue 1
