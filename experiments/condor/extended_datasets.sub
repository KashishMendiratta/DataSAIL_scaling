universe = docker
docker_image = $(image)
executable = experiments/condor/run_job.sh
seed = 42
arguments = $(repo_dir) $(dataset) $(method) $(sample_ratio) $(seed) $(n_jobs)
initialdir = $(repo_dir)

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
+WantGPUHomeMounted = true
requirements = (UidDomain == "cs.uni-saarland.de")

request_cpus = $(n_jobs)
request_memory = $(memory)
request_disk = $(disk)

log = $(repo_dir)/logs/condor/$(dataset).$(method).$(ClusterId).log
output = $(repo_dir)/logs/condor/$(dataset).$(method).$(ClusterId).$(ProcId).out
error = $(repo_dir)/logs/condor/$(dataset).$(method).$(ClusterId).$(ProcId).err

queue dataset, method, sample_ratio, memory, disk, n_jobs from (
qm9 all-local 0.02 128GB 20GB 8
pcba all-local 0.005 256GB 20GB 8
)
