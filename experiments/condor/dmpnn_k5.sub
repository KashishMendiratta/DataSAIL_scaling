universe = docker
docker_image = $(image)

environment = "DATASAIL_CONTAINER_REF=$(image) DATASAIL_GIT_COMMIT=$(git_commit) DATASAIL_GIT_WORKTREE_DIRTY=$(git_dirty) CONDOR_JOB_ID=$(ClusterId).$(ProcId)"

executable = experiments/condor/run_dmpnn_k5.sh
arguments = $(repo_dir) $(dataset) 50 10 64
initialdir = $(repo_dir)

should_transfer_files = YES
when_to_transfer_output = ON_EXIT

+WantGPUHomeMounted = true
requirements = (UidDomain == "cs.uni-saarland.de")

request_cpus = 4
request_memory = $(memory)
request_disk = 30GB

log = $(repo_dir)/logs/condor/dmpnn-k5.$(dataset).$(ClusterId).log
output = $(repo_dir)/logs/condor/dmpnn-k5.$(dataset).$(ClusterId).$(ProcId).out
error = $(repo_dir)/logs/condor/dmpnn-k5.$(dataset).$(ClusterId).$(ProcId).err

queue dataset, memory from (
bace    16GB
hiv     32GB
tox21   32GB
muv     48GB
esol    16GB
qm9     48GB
)
