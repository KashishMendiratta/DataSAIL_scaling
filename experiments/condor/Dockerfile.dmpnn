FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    libfontconfig1 libgomp1 libgl1 libsm6 libxext6 libxrender1 \
    && rm -rf /var/lib/apt/lists/*

# Install a pinned CPU-only build first.  Otherwise pip selects the newest
# Linux PyTorch distribution and downloads the multi-gigabyte CUDA stack.
RUN python -m pip install --no-cache-dir \
    --index-url https://download.pytorch.org/whl/cpu \
    torch==2.5.1+cpu

RUN python -m pip install --no-cache-dir \
    numpy==1.26.4 \
    pandas==2.3.3 \
    scikit-learn==1.7.2 \
    rdkit==2025.9.3 \
    chemprop==2.3.1

RUN python -c "import chemprop, rdkit, sklearn, torch; print('chemprop', chemprop.__version__); print('torch', torch.__version__); print('rdkit', rdkit.__version__); print('scikit-learn', sklearn.__version__)" \
    && chemprop --help >/dev/null

ENV MPLCONFIGDIR=/tmp/matplotlib
WORKDIR /workspace
