universe = docker
docker_image = kashishhm/datasail-scale:py310
executable = /home/kame00004/DataSAIL_scaling/experiments/condor/run_seed_analysis_stage.sh
arguments = /home/kame00004/DataSAIL_scaling $(stage) $(dataset)
initialdir = /home/kame00004/DataSAIL_scaling

should_transfer_files = YES
when_to_transfer_output = ON_EXIT
+WantGPUHomeMounted = true
requirements = (UidDomain == "cs.uni-saarland.de")

request_cpus = 1
request_memory = $(memory)
