log = /home/kame00004/DataSAIL_scaling/logs/condor/seed-analysis.$(stage).$(dataset).$(ClusterId).log
output = /home/kame00004/DataSAIL_scaling/logs/condor/seed-analysis.$(stage).$(dataset).$(ClusterId).$(ProcId).out
error = /home/kame00004/DataSAIL_scaling/logs/condor/seed-analysis.$(stage).$(dataset).$(ClusterId).$(ProcId).err

queue 1
