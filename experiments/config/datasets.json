{
  "version": 1,
  "defaults": {
    "split_ratios": {
      "train": 0.7,
      "val": 0.2,
      "test": 0.1
    },
    "seed": 42,
    "sample_ratio": 0.25,
    "fingerprint": {
      "type": "Morgan",
      "radius": 2,
      "bits": 2048
    },
    "assignment": {
      "method": "balanced_knn",
      "k": 5,
      "balance_weight": 2.0
    }
  },
  "datasets": {
    "bace": {
      "path": "data/raw/moleculenet/bace.csv",
      "id_column": "CID",
      "smiles_column": "mol",
      "task_type": "classification",
      "target_columns": [
        "Class"
      ],
      "stratify_column": "Class",
      "sample_ratio": 0.25
    },
    "bbbp": {
      "path": "data/raw/moleculenet/bbbp.csv",
      "id_column": "num",
      "smiles_column": "smiles",
      "task_type": "classification",
      "target_columns": [
        "p_np"
      ],
      "stratify_column": "p_np",
      "sample_ratio": 0.25
    },
    "tox21": {
      "path": "data/raw/moleculenet/tox21.csv",
      "id_column": "mol_id",
      "smiles_column": "smiles",
      "task_type": "classification",
      "target_columns": [
        "NR-AR",
        "NR-AR-LBD",
        "NR-AhR",
        "NR-Aromatase",
        "NR-ER",
        "NR-ER-LBD",
        "NR-PPAR-gamma",
        "SR-ARE",
        "SR-ATAD5",
        "SR-HSE",
        "SR-MMP",
        "SR-p53"
      ],
      "stratify_column": "NR-AR",
      "sample_ratio": 0.25
    },
    "hiv": {
      "path": "data/raw/moleculenet/hiv.csv",
      "id_column": null,
      "smiles_column": "smiles",
      "task_type": "classification",
      "target_columns": [
        "HIV_active"
      ],
      "stratify_column": "HIV_active",
      "sample_ratio": 0.25
    },
    "qm9": {
      "path": "data/raw/moleculenet/qm9.csv",
      "id_column": "mol_id",
      "smiles_column": "smiles",
      "task_type": "regression",
      "target_columns": null,
      "stratify_column": "mu",
      "sample_ratio": 0.02
    },
    "pcba": {
      "path": "data/raw/moleculenet/pcba.csv.gz",
      "compression": "gzip",
      "id_column": "mol_id",
      "smiles_column": "smiles",
      "task_type": "classification_multitask",
      "target_prefix": "PCBA-",
      "target_columns": null,
      "stratify_column": "PCBA-1030",
      "sample_ratio": 0.005
    },
    "muv": {
      "path": "data/raw/moleculenet/muv.csv.gz",
      "compression": "gzip",
      "id_column": "mol_id",
      "smiles_column": "smiles",
      "task_type": "classification_multitask",
      "target_prefix": "MUV-",
      "target_columns": null,
      "stratify_column": "MUV-466",
      "sample_ratio": 0.02
    },
    "esol": {
      "path": "data/raw/moleculenet/delaney-processed.csv",
      "id_column": "Compound ID",
      "smiles_column": "smiles",
      "task_type": "regression",
      "target_columns": [
        "measured log solubility in mols per litre"
      ],
      "stratify_column": "measured log solubility in mols per litre",
      "sample_ratio": 0.05
    },
    "freesolv": {
      "path": "data/raw/moleculenet/SAMPL.csv",
      "id_column": "iupac",
      "smiles_column": "smiles",
      "task_type": "regression",
      "target_columns": [
        "expt"
      ],
      "stratify_column": "expt",
      "sample_ratio": 0.1
    },
    "lipophilicity": {
      "path": "data/raw/moleculenet/Lipophilicity.csv",
      "id_column": "CMPD_CHEMBLID",
      "smiles_column": "smiles",
      "task_type": "regression",
      "target_columns": [
        "exp"
      ],
      "stratify_column": "exp",
      "sample_ratio": 0.05
    }
  },
  "default_datasets": [
    "bace",
    "bbbp",
    "tox21",
    "hiv"
  ]
}
